<?xml version="1.0"?>
<robot name="cobot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="link_len" value="0.3"/>
  <xacro:property name="link_radius" value="0.04"/>
  <xacro:property name="joint_effort" value="50.0"/>
  <xacro:property name="joint_velocity" value="2.0"/>

  <link name="base_link">
    <visual>
      <geometry><cylinder radius="0.08" length="0.1"/></geometry>
    </visual>
    <collision>
      <geometry><cylinder radius="0.08" length="0.1"/></geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <xacro:macro name="arm_segment" params="name parent axis_xyz origin_xyz">
    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 ${link_len/2}"/>
        <geometry><cylinder radius="${link_radius}" length="${link_len}"/></geometry>
      </visual>
      <collision>
        <origin xyz="0 0 ${link_len/2}"/>
        <geometry><cylinder radius="${link_radius}" length="${link_len}"/></geometry>
      </collision>
      <inertial>
        <mass value="1.0"/>
        <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.002"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="revolute">
      <parent link="${parent}"/>
      <child link="${name}_link"/>
      <origin xyz="${origin_xyz}"/>
      <axis xyz="${axis_xyz}"/>
      <limit lower="-3.14" upper="3.14" effort="${joint_effort}" velocity="${joint_velocity}"/>
    </joint>
  </xacro:macro>

  <xacro:arm_segment name="joint_1" parent="base_link" axis_xyz="0 0 1" origin_xyz="0 0 0.05"/>
  <xacro:arm_segment name="joint_2" parent="joint_1_link" axis_xyz="0 1 0" origin_xyz="0 0 ${link_len}"/>
  <xacro:arm_segment name="joint_3" parent="joint_2_link" axis_xyz="0 1 0" origin_xyz="0 0 ${link_len}"/>
  <xacro:arm_segment name="joint_4" parent="joint_3_link" axis_xyz="0 0 1" origin_xyz="0 0 ${link_len}"/>
  <xacro:arm_segment name="joint_5" parent="joint_4_link" axis_xyz="0 1 0" origin_xyz="0 0 ${link_len}"/>
  <xacro:arm_segment name="joint_6" parent="joint_5_link" axis_xyz="0 0 1" origin_xyz="0 0 ${link_len}"/>

  <link name="tool0"/>
  <joint name="tool0_fixed" type="fixed">
    <parent link="joint_6_link"/>
    <child link="tool0"/>
    <origin xyz="0 0 ${link_len}"/>
  </joint>

  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher"/>
    <plugin filename="gz-sim-pose-publisher-system"
            name="gz::sim::systems::PosePublisher">
      <publish_link_pose>true</publish_link_pose>
      <update_frequency>50</update_frequency>
    </plugin>
  </gazebo>

  <xacro:include filename="$(find cobot_description)/urdf/cobot.ros2_control.xacro"/>
</robot>
